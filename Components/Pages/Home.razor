            "@type": "PostalAddress",
            "streetAddress": "Rua Amélia Augusta do Nascimento, 24",
            "addressLocality": "Betim",
            "addressRegion": "MG",
            "postalCode": "32671-520",
            "addressCountry": "BR"
          },
          "hasMap": "https://maps.app.goo.gl/JQEt8v7VXzqyCsE3A",
          "openingHoursSpecification": [
            { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "17:00", "closes": "21:00" },

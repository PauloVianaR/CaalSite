            { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "08:00", "closes": "18:00" }
          ]
        }
        """;

    private IJSObjectReference? _module;
    private ElementReference _lightboxElement;
    private string _activeFilter = "Todos";
    private MediaItem? _selectedImage;
    private bool _menuOpen;

    private string TrialUrl => SiteContent.WhatsAppUrl(TrialMessage);
    private string WhatsAppUrl => SiteContent.WhatsAppUrl(GeneralMessage);
    private IReadOnlyList<MediaItem> FilteredGallery => _activeFilter == "Todos"
        ? SiteContent.Gallery
        : SiteContent.Gallery.Where(image => image.Category == _activeFilter).ToArray();
    private int CurrentLightboxIndex
    {
        get
        {
            if (_selectedImage is null) return -1;

            for (var index = 0; index < FilteredGallery.Count; index++)
            {
                if (FilteredGallery[index] == _selectedImage) return index;
            }

            return -1;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/site.js");
        await _module.InvokeVoidAsync("init");
    }

    private async Task ToggleMenuAsync()
    {
        _menuOpen = !_menuOpen;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setBodyLock", _menuOpen);
        }
    }

    private async Task CloseMenu()
    {
        _menuOpen = false;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setBodyLock", false);
        }
    }

    private async Task SetFilterAsync(string filter)
    {
        _activeFilter = filter;
        _selectedImage = null;
        await InvokeAsync(StateHasChanged);

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("refreshReveals");
        }
    }

    private async Task OpenLightboxAsync(MediaItem item)
    {
        _selectedImage = item;
        await InvokeAsync(StateHasChanged);

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setBodyLock", true);
        }

        await _lightboxElement.FocusAsync();
    }

    private async Task CloseLightboxAsync()
    {
        _selectedImage = null;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setBodyLock", false);
        }
    }

    private void PreviousImage()
    {
        if (_selectedImage is null || FilteredGallery.Count == 0) return;
        var index = CurrentLightboxIndex <= 0 ? FilteredGallery.Count - 1 : CurrentLightboxIndex - 1;
        _selectedImage = FilteredGallery[index];
    }

    private void NextImage()
    {
        if (_selectedImage is null || FilteredGallery.Count == 0) return;
        var index = CurrentLightboxIndex >= FilteredGallery.Count - 1 ? 0 : CurrentLightboxIndex + 1;
        _selectedImage = FilteredGallery[index];
    }

    private async Task HandleLightboxKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Escape":
                await CloseLightboxAsync();
                break;
            case "ArrowLeft":
                PreviousImage();
                break;
            case "ArrowRight":
                NextImage();
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;

        try
        {
            await _module.InvokeVoidAsync("destroy");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // A conexão do circuito pode já ter sido encerrada durante a navegação.
        }
    }
}
